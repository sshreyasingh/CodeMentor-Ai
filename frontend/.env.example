# Vite environment variables
# In development, set these in frontend/.env.local (not checked in)
# In production, the backend serves the frontend so these are not needed

# Override the default API URL (dev only — production uses relative paths)
# VITE_API_URL=http://localhost:5000/api/v1

# Override the default Socket URL (dev only — production uses same origin)
# VITE_SOCKET_URL=http://localhost:5000
