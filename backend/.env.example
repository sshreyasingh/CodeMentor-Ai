# ========================================
# CodeMentor AI — Environment Variables
# ========================================

# Required: MongoDB connection string
# Get a free MongoDB Atlas cluster at https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/codementor-ai?retryWrites=true&w=majority

# Required: Session secret (use a long random string)
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=generate_a_random_secret_here

# Required: Client URL (the frontend URL)
# Development: http://localhost:5173
# Production: https://yourdomain.com
CLIENT_URL=http://localhost:5173

# Server port
PORT=5000

# Environment: development | production
NODE_ENV=development

# ---- AI Services (at least one required) ----

# OpenRouter API — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# Groq API (optional fallback) — https://console.groq.com/keys
GROQ_API_KEY=

# ---- Code Execution ----

# JDoodle API — https://www.jdoodle.com/compiler-api
JDOODLE_CLIENT_ID=your_jdoodle_client_id
JDOODLE_CLIENT_SECRET=your_jdoodle_client_secret

# ---- GitHub OAuth (optional) ----

# Create OAuth app at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback
